# Supabase - Project URL and public anon key (safe to expose to browser)
# Source: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Source: Supabase Dashboard -> Project Settings -> API -> anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role key - SERVER ONLY, never prefix with NEXT_PUBLIC_
# Source: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Access Token for CLI (non-interactive db push)
# Source: Supabase Dashboard -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=your-access-token-here

# Supabase DB password (for direct DB connection)
# Source: Supabase Dashboard -> Project Settings -> Database -> Connection password
SUPABASE_DB_PASSWORD=your-db-password-here

# Test user credentials (per role - for integration tests)
# Create these users in Supabase Auth before running tests
TEST_MANAGER_EMAIL=test-manager@example.com
TEST_MANAGER_PASSWORD=test-password-here
TEST_TENANT_EMAIL=test-tenant@example.com
TEST_TENANT_PASSWORD=test-password-here
TEST_OWNER_EMAIL=test-owner@example.com
TEST_OWNER_PASSWORD=test-password-here
TEST_VENDOR_EMAIL=test-vendor@example.com
TEST_VENDOR_PASSWORD=test-password-here
TEST_ADMIN_EMAIL=test-admin@example.com
TEST_ADMIN_PASSWORD=test-password-here

# Hospitable Public API PAT — SERVER ONLY, never prefix with NEXT_PUBLIC_
# Source: Hospitable Dashboard -> Settings -> API -> Personal Access Tokens
HOSPITABLE_API_PAT=your-hospitable-pat-here

# Hospitable Direct Booking site UUID (`data-site-uuid` on the widget loader) — SERVER ONLY
# Org-level; same value for every property widget. Per-property numeric IDs live on
# units.hospitable_widget_property_id (manager-editable). Defaults to Canary's site when unset.
# Source: Hospitable Dashboard -> Direct Bookings -> Website -> Copy widget code
# HOSPITABLE_SITE_UUID=9f1c2015-de57-4be3-a80c-1927d81e8f41

# Pingram — SERVER ONLY (all transactional email + SMS)
# Source: Pingram Dashboard -> Environments -> API key (pingram_sk_...)
# Canadian region: code uses region: 'ca' (api.ca.pingram.io)
# Dashboard must allow notification types in src/lib/email/pingram-types.ts
PINGRAM_API_KEY=pingram_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional override for company notification on "Notify me" signups (defaults to info@canarypm.ca)
# LISTING_ALERT_NOTIFY_EMAIL=info@canarypm.ca

# Public app URL used in email links
# NEXT_PUBLIC_APP_URL=https://canarypm.ca

# Default org slug for the marketing landing page
# NEXT_PUBLIC_DEFAULT_ORG_SLUG=canary

# Gmail OAuth (org inbox sync + Interac e-transfer detection) — SERVER ONLY
# Source: Google Cloud Console -> APIs & Services -> Credentials (OAuth 2.0 Client)
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
# Must match an authorized redirect URI on the OAuth client
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Google Drive OAuth (property photo browse/import + linked-folder sync) — SERVER ONLY
# Reuses GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET.
# Optional: if omitted, derived from GMAIL_REDIRECT_URI (…/gmail/callback → …/drive/callback).
# You MUST still register the Drive callback on the Google OAuth client Authorized redirect URIs:
#   http://localhost:3000/api/drive/callback
#   https://canarypm.ca/api/drive/callback
# Also enable the Google Drive API for the Cloud project.
# DRIVE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Google Tasks OAuth (import incomplete tasks into Team tasks board) — SERVER ONLY
# Reuses GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET.
# Optional: if omitted, derived from GMAIL_REDIRECT_URI (…/gmail/callback → …/google-tasks/callback).
# You MUST still register the Tasks callback on the Google OAuth client Authorized redirect URIs:
#   http://localhost:3000/api/google-tasks/callback
#   https://canarypm.ca/api/google-tasks/callback
# Also enable the Google Tasks API for the Cloud project.
# TASKS_REDIRECT_URI=http://localhost:3000/api/google-tasks/callback

# Vercel Cron secret for /api/cron/drive-photo-sync (Authorization: Bearer <secret>)
# Required for the daily Drive photo sync cron (vercel.json: 0 12 * * * on Hobby).
# CRON_SECRET=your-random-cron-secret

# Optional: force full-size listing card images (skip Supabase Image Transformations).
# Set to 0/false/off if Storage → Image Transformations is disabled or render URLs 404.
# When unset, preview signing probes /render/image once and falls back to full URLs automatically.
# SUPABASE_IMAGE_TRANSFORMS=0

# Anthropic — Ask Canary + Gmail AI classification (optional; rules still work without it)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Vercel AI Gateway — preferred path for new AI features (listing descriptions, future assistants)
# Dashboard: Vercel project → AI Gateway → create key, or use OIDC after `vercel link` + `vercel env pull`
# AI_GATEWAY_API_KEY=vck_...
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.5

# Cron also covers /api/cron/rent-charges (1st of month 13:00 UTC) — same CRON_SECRET as Drive sync
